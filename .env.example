# Meta MMS ASR model (STT — do NOT use facebook/mms-tts-*)
MODEL_ID=facebook/mms-1b-all

# Inference device: cpu | cuda
# This laptop has no NVIDIA GPU → keep cpu here.
# On g4dn.xlarge use: DEVICE=cuda
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build -d
DEVICE=cpu

# HTTP listen port (container internal)
PORT=8000

# Max multipart upload size
MAX_UPLOAD_MB=50

# Hugging Face cache directory (model weights)
HF_HOME=/models/hf

# Optional shared token. Leave empty to disable auth (default).
# When set, clients must send header: X-API-Key: <value>
API_KEY=

# Comma-separated MMS ISO-639-3 adapters to warm at startup
PRELOAD_LANGS=amh,eng

# CTC cue packing (subtitle-sized segments)
CUE_MAX_CHARS=48
CUE_MAX_SECONDS=5.0

# Where to write .vtt files (set empty to skip disk write; JSON still has `vtt`)
VTT_OUTPUT_DIR=outputs/vtt

# Long-audio chunking (podcast-length clips)
CHUNK_SECONDS=30
CHUNK_OVERLAP_SECONDS=1
